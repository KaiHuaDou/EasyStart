<Window x:Class="StartPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StartPro"
        xmlns:notify="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:text="clr-namespace:StartPro.Resources"
        xmlns:tile="clr-namespace:StartPro.Tile"
        Closing="WindowClosing"
        Deactivated="WindowDeactivated"
        Loaded="WindowLoaded"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary Source="/Theme.xaml" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <ContentPresenter ClipToBounds="True" />
        </ControlTemplate>
    </Window.Template>
    <Border x:Name="MainBorder" RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <DockPanel>
            <Border DockPanel.Dock="Bottom"
                    VerticalAlignment="Bottom" Panel.ZIndex="64"
                    Background="#99FFFFFF">
                <Border.Effect>
                    <DropShadowEffect Opacity="0.2" Direction="90" Color="#ACACAC" />
                </Border.Effect>
                <Grid>
                    <Grid.Resources>
                        <Style BasedOn="{StaticResource {x:Type GroupBox}}" TargetType="{x:Type GroupBox}">
                            <Setter Property="Margin" Value="5" />
                        </Style>
                        <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="Orientation" Value="Horizontal" />
                        </Style>
                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="Margin" Value="5,5,5,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style BasedOn="{StaticResource {x:Type ToolTip}}" TargetType="{x:Type ToolTip}">
                            <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}" />
                        </Style>
                        <Style BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="{x:Type ToggleButton}">
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                            <Setter Property="FontSize" Value="24" />
                            <Setter Property="Margin" Value="5,5,5,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>
                    <StackPanel x:Name="FunctionPanel" HorizontalAlignment="Center">
                        <GroupBox Header="{x:Static text:Info.PowerGroup}">
                            <StackPanel>
                                <Button Click="PowerShutdown" Content="&#xE7E8;" ToolTip="{x:Static text:Info.PowerShutdown}" />
                                <Button Click="PowerRestart" Content="&#xE777;" ToolTip="{x:Static text:Info.PowerRestart}" />
                                <Button Click="PowerSleep" Content="&#xE708;" ToolTip="{x:Static text:Info.PowerSleep}" />
                                <Button Click="PowerLock" Content="&#xE72E;" ToolTip="{x:Static text:Info.PowerLock}" />
                                <Button Click="PowerLogout" Content="&#xF3B1;" ToolTip="{x:Static text:Info.PowerLogout}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{x:Static text:Main.DefaultGroup}">
                            <StackPanel>
                                <Button Click="ShowSetting" Content="&#xE713;" ToolTip="{x:Static text:Info.Setting}" />
                                <Button Click="WindowExit" Content="&#xE711;" ToolTip="{x:Static text:Info.Exit}" />
                                <Button x:Name="SaveDataButton"
                                        Click="SaveData" Content="&#xE74E;"
                                        ToolTip="{x:Static text:Info.SaveData}" />
                                <Button Click="OpenConfigFolder" Content="&#xE838;" ToolTip="{x:Static text:Info.OpenConfigFolder}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{x:Static text:AppTile.AppTileGroup}">
                            <StackPanel>
                                <ToggleButton x:Name="AppListSwitchButton"
                                              Click="SwitchAppList" Content="&#xE700;"
                                              ToolTip="{x:Static text:Info.SwitchAppList}" />
                                <Button Click="AddAppTile" Content="&#xE710;" ToolTip="{x:Static text:Info.AddAppTile}" />
                                <Button x:Name="ImportSystemStartButton"
                                        Click="ImportSystemStart" Content="&#xE8B6;"
                                        ToolTip="{x:Static text:Info.ImportSystemStart}" />
                                <Button Click="ImportAppTile" Content="&#xE8B5;" ToolTip="{x:Static text:Info.ImportAppTile}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{x:Static text:TextTile.TextTileGroup}">
                            <StackPanel>
                                <Button Click="AddTextTile" Content="&#xE710;" ToolTip="{x:Static text:Info.AddTextTile}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="{x:Static text:ImageTile.ImageTileGroup}">
                            <StackPanel>
                                <Button Click="AddImageTile" Content="&#xE710;" ToolTip="{x:Static text:Info.AddImageTile}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox x:Name="InfoGroup" Header="{x:Static text:Info.InfoGroup}"
                                  Margin="5,5,10,5" HorizontalAlignment="Right">
                            <StackPanel>
                                <ComboBox x:Name="InfoBox" Margin="5,5,5,0" SelectedIndex="0" />
                                <Button Click="ClearInfo" Content="&#xE711;" ToolTip="{x:Static text:Info.DeleteMessage}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="MainGrid">
                <ScrollViewer x:Name="TilePanelScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                    <Canvas x:Name="TilePanel"
                            Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="Transparent" />
                </ScrollViewer>
                <ScrollViewer x:Name="AppListScroll"
                              Margin="0,20,0,20"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppList" Background="Transparent" BorderThickness="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="{Binding ElementName=MainBorder, Path=ActualWidth}" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Converter={StaticResource WidthConverter}}"
                                        Margin="10" Padding="5"
                                        BorderBrush="Gray"
                                        CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MaskLightBrush}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <DockPanel.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{x:Static text:Main.PinAppText}" Click="PinApp" CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>
                                        <Image Height="32" Source="{Binding AppIcon}" Stretch="Uniform" />
                                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding AppName}"
                                                   TextWrapping="WrapWithOverflow" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <notify:TaskbarIcon MenuActivation="RightClick">
                <notify:TaskbarIcon.IconSource>
                    <notify:GeneratedIconSource Foreground="White"
                                                FontFamily="Segoe Fluent Icons" FontSize="64" FontWeight="ExtraBlack"
                                                Text="&#xF71C;" />
                </notify:TaskbarIcon.IconSource>
                <notify:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static text:Main.TrayShowHide}" Click="TaskbarMenuShow" />
                        <MenuItem Header="{x:Static text:Main.TrayExit}" Click="TaskbarMenuExit" />
                    </ContextMenu>
                </notify:TaskbarIcon.ContextMenu>
            </notify:TaskbarIcon>
        </DockPanel>
    </Border>
</Window>
